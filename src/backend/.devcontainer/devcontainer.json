{
    "name": "crypto-sss-backend",
    "dockerComposeFile": "../../../deployments/docker-compose.yml",
    "service": "crypto-sss-backend",
    "workspaceFolder": "/workspaces/crypto-sss-backend",
    "mounts": [
        "type=bind,source=${localWorkspaceFolder},target=/workspaces/crypto-sss-backend,consistency=cached"
    ],
    "forwardsPorts": [
        "3000:3000",
        "27017:27017"
    ],
    "postCreateCommand": "go mod tidy && go mod verify",
    "postAttachCommand": "go run cmd/backend.go"
}